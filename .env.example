# ── Copy this file to .env.local for local dev, and set the same keys in Vercel ──
# ── (Project → Settings → Environment Variables) for production.               ──

# Paddle environment: "production" (live) or "sandbox" (testing).
PADDLE_ENVIRONMENT=production

# Paddle API key (server-side SECRET) — Paddle → Developer tools → Authentication.
# This is the only Paddle secret. Never commit it. Set it in Vercel.
PADDLE_API_KEY=pdl_live_xxx

# The client token and price IDs are non-secret and already pre-filled as
# defaults in api/config.js, so you can leave these blank. Only set them here
# if you want to override the defaults.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_10=
PADDLE_PRICE_15=
PADDLE_PRICE_20=

# Anthropic — from console.anthropic.com (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# A long random secret used to sign access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Upstash Redis (free tier) — caps usage per purchase, protecting your Anthropic bill.
# From console.upstash.com → your database → REST API. Strongly recommended.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many messages one purchase unlocks, and how long the session stays open (seconds).
SESSION_MESSAGE_BUDGET=60
SESSION_TTL_SECONDS=86400
